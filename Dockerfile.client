FROM node:18-slim AS builder

WORKDIR /app

# 1. 构建 shared 模块
COPY shared ./shared
WORKDIR /app/shared
RUN npm config set fetch-retry-maxtimeout 600000 && npm config set fetch-retry-mintimeout 10000
RUN npm install
RUN npm run build

# 2. 构建 client 模块
WORKDIR /app
COPY client ./client
WORKDIR /app/client
RUN npm config set fetch-retry-maxtimeout 600000 && npm config set fetch-retry-mintimeout 10000
RUN npm install
# 临时修改构建命令，跳过 TypeScript 类型检查（节省内存，避免报错）
# 增加内存限制，防止构建时 OOM
ENV NODE_OPTIONS="--max-old-space-size=4096"

# 构建项目
RUN npm run build

# 3. Nginx 托管
FROM nginx:alpine
COPY --from=builder /app/client/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
