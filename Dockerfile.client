FROM node:18-slim AS builder

WORKDIR /app

# 复制 client 模块（现在 shared 类型已内联到 client/src/types/shared.ts）
COPY client ./client

# 进入 client 目录并安装依赖
WORKDIR /app/client

# 删除对 shared 包的依赖（如果存在）
RUN sed -i '/@polysniper\/shared-types/d' package.json 2>/dev/null || true

RUN npm config set fetch-retry-maxtimeout 600000 && npm config set fetch-retry-mintimeout 10000
RUN npm install

# 增加内存限制，防止构建时 OOM
ENV NODE_OPTIONS="--max-old-space-size=4096"

# 构建项目
RUN npm run build

# Nginx 托管
FROM nginx:alpine
COPY --from=builder /app/client/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
