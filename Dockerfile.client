FROM node:18-slim AS builder

WORKDIR /app

# 1. 复制 client 模块
COPY client ./client

# 2. 关键：将 shared/types 直接复制到 client/src/shared-types 目录
#    这样 shared 类型就成为 client 源码的一部分，完全不依赖外部路径
COPY shared/types ./client/src/shared-types

# 3. 进入 client 目录并安装依赖
WORKDIR /app/client

# 删除对 shared 包的依赖（因为现在类型已经内联了）
# 这里用 sed 移除 package.json 中的 @polysniper/shared-types 依赖
RUN sed -i '/@polysniper\/shared-types/d' package.json

RUN npm config set fetch-retry-maxtimeout 600000 && npm config set fetch-retry-mintimeout 10000
RUN npm install

# 增加内存限制，防止构建时 OOM
ENV NODE_OPTIONS="--max-old-space-size=4096"
# 设置环境变量，让 vite.config.ts 知道这是 Docker 构建环境
ENV DOCKER_BUILD=true

# 使用 Docker 专用的 tsconfig（路径指向 src/shared-types 而非 ../shared/types）
RUN cp tsconfig.docker.json tsconfig.app.json

# 构建项目
RUN npm run build

# 4. Nginx 托管
FROM nginx:alpine
COPY --from=builder /app/client/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
