# 服务配置
PORT=3000
NODE_ENV=development

# Polymarket API 配置
# Gamma Markets API - 用于获取市场数据（公开，无需认证）✅
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
# CLOB API - 用于交易（需要 API Key 和钱包私钥，当前项目不使用）
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
# WebSocket - 实时价格推送（market channel 是公开的，无需认证）✅
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_WS_ENABLED=true  # 已成功实现（2026-01-01）
# WebSocket 代理设置（国内需要代理访问）⚠️ 必需
POLYMARKET_WS_PROXY=http://127.0.0.1:7890  # Clash 默认端口
# POLYMARKET_WS_PROXY=http://127.0.0.1:7891  # 其他代理端口
# POLYMARKET_WS_PROXY=none  # 禁用代理（服务器在国外时）
# ⚠️ 心跳机制：使用 WebSocket 协议层 Ping/Pong（每15秒，自动实现）
# API Key - 仅在需要 user channel 或交易时需要（监控价格不需要）
# 💡 market channel（订单簿、价格）是公开的，匿名订阅即可
POLYMARKET_API_KEY=

# Redis 配置 (可选)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# 缓存配置 (秒)
CACHE_TTL_LIVE=45
CACHE_TTL_UPCOMING=120
CACHE_TTL_ENDED=86400

# 限流配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# 日志配置
LOG_LEVEL=info

# 📝 说明：
# 1. 监控价格（当前项目）：无需任何 API Key ✅
#    - REST API: POLYMARKET_GAMMA_API_URL（轮询，45秒）
#    - WebSocket: market channel 公开，匿名订阅（实时，< 1秒）
#    - 心跳机制: 协议层 Ping/Pong 每15秒（自动）
# 2. 查看个人订单：需要 API Key（user channel）
# 3. 交易功能：需要 API Key + 钱包私钥（当前项目不涉及）
# 
# 详细文档: server/docs/WEBSOCKET.md
